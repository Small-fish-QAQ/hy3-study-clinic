# ------------------------------------------------------------------
# Hy3 Study Clinic — server-side environment configuration (EXAMPLE)
#
# Copy to `.env` for local use. NEVER commit a real `.env` file and
# NEVER put credentials in this example file.
#
# New installations select MoMA; fill the connection in Settings before teaching.
# Explicit LLM_PROVIDER=fake is still available for offline development/tests.
# ------------------------------------------------------------------

# "moma" (default), "compatible", historical "hy3", or explicit offline "fake"
LLM_PROVIDER=moma

# --- Hy3 (OpenAI-compatible HTTP API) settings ---
# Optional startup fallback for any real provider. Saved UI configuration wins.
# Example shape: https://your-hy3-endpoint.example.com/v1
HY3_BASE_URL=
HY3_API_KEY=
HY3_MODEL=
# Request timeout in milliseconds (default 30000)
HY3_TIMEOUT_MS=30000
LONG_TASK_TIMEOUT_MS=240000
# Optional known context limit and soft reasoning estimate (no mandatory floor).
# MODEL_CONTEXT_TOKENS=131072
# MODEL_REASONING_ESTIMATE=20000
# Actual import resources; no course knowledge/lesson/count caps.
IMPORT_FILE_BYTES=10485760
IMPORT_TEXT_BYTES=10485760
# Internal output ceiling. Keep the established bounded truncation recovery;
# set a lower documented model limit if needed. Explicit upstream caps are learned.
MODEL_MAX_OUTPUT_TOKENS=64000
PROVIDER_CONCURRENCY=2
OPERATION_LEASE_MS=90000
OPERATION_HEARTBEAT_MS=20000
# Optional ignored, user-local Settings override. Defaults to ./data/provider-config.json.
PROVIDER_CONFIG_PATH=./data/provider-config.json

# Automation only: fail closed after saved/environment precedence resolves.
# Set this in browser/eval fixtures that must never use an external provider.
# AUTOMATION_EXPECT_PROVIDER=fake

# --- Dedicated TokenHub visual-description settings ---
# Keep disabled for the submitted Hy3 workflow and every evaluation run.
# Optional visual preparation is advisory only; see docs/SETUP.md.
VISUAL_PROVIDER=disabled
TOKENHUB_VISUAL_BASE_URL=https://tokenhub.tencentmaas.com/v1
TOKENHUB_VISUAL_API_KEY=
TOKENHUB_VISUAL_MODEL=hy-vision-2.0-instruct
# Per physical visual request; one normal request plus at most one repair.
TOKENHUB_VISUAL_TIMEOUT_MS=120000

# --- Server settings ---
PORT=8787
HOST=127.0.0.1
# SQLite database file path (created automatically; ":memory:" for ephemeral)
DATABASE_PATH=./data/clinic-v2.sqlite

  "lesson": {
    "objective": {
      "title": "比较级与最高级形式与用法：区分、构词与造句",
      "whyNow": "学习者常把比较级和最高级混用，例如在只有两者时套用最高级，或在集合中误指最值。需要明确区分对象数量与范围标记。",
      "outcomes": [
        {
          "title": "区分两者比较与给定集合最高程度",
          "description": "能够区分比较级（常配合than比较两个对象在某方面的程度）与最高级（表示在给定集合中达到最高程度，通常使用the并交代比较范围，而非不受范围限制的绝对第一）。"
        },
        {
          "title": "按给定词形规则构成比较级与最高级",
          "description": "能够根据给定词形规则构成比较级与最高级：短形容词加-er/-est（如tall/taller/tallest），长形容词用more/most（如careful/more careful/most careful），不发音e结尾加-r/-st（如large/larger/largest），辅音字母加y结尾变y为i加-er/-est（如heavy/heavier/heaviest，避免heavyer错误），部分短词双写末尾辅音（如big/bigger/biggest），不规则词形good/better/best与bad/worse/worst；避免叠加两套标记（如not more bigger、not most tallest），并遵循本课明确给出的词形练习约定。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "英语中比较级用于两个对象在某维度上的程度差异，常配合than；最高级表示在明确给出的集合中达到极致，通常用the并交代范围，如of the three。根据资料中的规则，先判定对象数量和比较维度，再选词形。例如两棵树：树1高2米，树2高3米，可写树2比树1高；三栋楼：楼A10米、楼B20米、楼C30米，楼C是三者中最高的。最高级不是脱离范围的绝对第一。",
        "explanationOrigin": "hy3_synthesis",

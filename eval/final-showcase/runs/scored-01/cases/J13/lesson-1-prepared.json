  "lesson": {
    "objective": {
      "title": "溶解度定义解释、饱和判断与冷却析出计算",
      "whyNow": "若把溶解度误写为每100克溶液中的克数，会错判饱和状态；我们需要先建立溶剂基准与数据边界。",
      "outcomes": [
        {
          "title": "解释溶解度定义的溶剂基准与数据局限",
          "description": "解释在指定温度下，固体溶解度表示达到饱和时每100克溶剂（水）中最多溶解的溶质克数，而非每100克溶液；并说明本课规则仅使用给定物质X的数据，不推广为所有固体随温度变化的共同数值规律。"
        },
        {
          "title": "计算溶解上限并判断饱和状态与剩余固体",
          "description": "根据水量和指定温度溶解度（仅使用20℃和50℃两温度不作插值），运用公式“水的质量×溶解度÷100”计算可溶上限；比较已溶质量与上限判断未饱和或饱和，确定剩余固体量；并理解饱和状态不要求容器底部必有剩余固体。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "固体溶解度指在指定温度下，每100克溶剂（本课为水）最多溶解的溶质克数，不是每100克溶液。例如20°C时X溶解度30，表示100克水最多溶30克X，得到130克饱和溶液；若取20克水，最多溶20×30÷100=6克X，溶液总质量26克。分母始终是水质量，不是配好的溶液质量。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "mechanism",
        "explanation": "因为溶解度分母固定为水，计算某水量下的溶解上限就用“水的质量×溶解度÷100”。这一规则导致：溶液总质量虽包含溶质，但不改变上限计算中的分母。例如20°C下40克水最多溶40×30÷100=12克X，液相溶液质量变为52克，但判断饱和只看12克是否等于上限，与52克无关。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [
          {
            "kind": "mechanism_effect",
            "fromProposition": "溶解度以100克水为基准定义",
            "toProposition": "某水量下上限=水质量×溶解度÷100，与溶液总质量无关",
            "origin": "hy3_synthesis",
            "sources": []
          }
        ],
        "workedProcess": null,
        "example": null,
        "contrast": null,

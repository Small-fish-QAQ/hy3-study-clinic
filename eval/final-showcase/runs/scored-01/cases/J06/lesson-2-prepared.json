            "动能8焦耳"
          ],
          "ruleOrProcedure": "E=1/2 m v² ⇒ v²=2E/m；速率v为非负平方根；动能不指示方向。",
          "steps": [
            {
              "action": "计算速率平方：v²=2×8/4",
              "reason": "代入E=8、m=4，先算分子2E=16，除以4得4",
              "resultingState": "v²=4"
            }
          ],

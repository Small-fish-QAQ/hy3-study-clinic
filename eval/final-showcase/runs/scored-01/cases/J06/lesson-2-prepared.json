  "lesson": {
    "objective": {
      "title": "动能公式含义、单位统一计算与比例反求",
      "whyNow": "若两辆小车质量和速率都变了，如何不重算绝对动能而快速判断谁动能更大？",
      "outcomes": [
        {
          "title": "应用质量或速率变化时的动能比例比较",
          "description": "应用比例关系比较动能：速率不变时动能与质量成正比；质量不变时动能随速率平方变化；两因素同时改变时分别比较再相乘（新质量为a倍、新速率为b倍则动能比a×b²）；使用同一参考系与单位，认识更重物体不一定动能更大。"
        },
        {
          "title": "应用由动能和质量反求速率并区分方向与速率",
          "description": "应用v²=2E/m由已知动能和质量求速率，取非负平方根；说明动能本身不指示运动方向，相反方向相同速率动能相同；若一维速度带负号仅表示方向，速率仍为正，动能不为负。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "比较不同物体的动能时，先分别看质量和速率。例如小车P质量1千克、速率3米每秒，动能为4.5焦耳；小车Q质量3千克、速率1米每秒，动能为1.5焦耳。Q更重但动能更小，因为速率平方起了决定作用。这种分别比较再相乘的思路，适用于任何两因素同时改变的情形。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "worked_example",
        "explanation": "当同一物体两个属性都变，可先算初始动能，再用倍数乘积预测新动能。下面用例题展示步骤，但先只算第一步，后续留给你。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": {
          "startingState": "物体乙质量5千克，以4米每秒运动（同一参考系，单位千克与米每秒）。",
          "inputs": [
            "初始质量5千克",
            "初始速率4米每秒",
            "变更后质量10千克（原2倍）",
            "变更后速率2米每秒（原1/2）"
          ],
          "ruleOrProcedure": "E=1/2 m v²；两因素同变时动能比 = 质量倍数 × (速率倍数)²。",
          "steps": [
            {
              "action": "计算初始动能：E初=1/2×5×4²",

  "lesson": {
    "objective": {
      "title": "动能公式含义、单位统一计算与比例反求",
      "whyNow": "实验中我们常测得动能却不知质量或速率如何变化，需要先用模型反推变量，并清楚公式何处失效。",
      "outcomes": [
        {
          "title": "解释经典低速平动动能模型E=1/2mv²的要素与边界",
          "description": "解释在同一参考系中普通低速物体的平动动能公式E=1/2×m×v²：说明m为质量、v为速率（速度大小），质量用千克、速率用米每秒时结果为焦耳；要求同一参考系；并指出该式属于经典低速模型，本课不讨论接近光速运动，也不自动并入转动能量或其他储能。"
        },
        {
          "title": "应用动能公式进行单位统一与正确计算",
          "description": "应用E=1/2×m×v²计算动能：计算前统一单位，若质量以克给出先换算为千克；先平方速率再乘质量与1/2，不漏掉平方也不将v²误写为v×2；使用同一参考系与单位得出焦耳结果。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "在同一参考系中，普通低速物体的平动动能可用E=1/2×m×v²表示。m是质量，v是速率（速度大小）。当质量用千克、速率用米每秒时，结果单位为焦耳。该式只计平动，不自动包含转动或其他储能，也不用于接近光速的运动。这是后续计算与反求的基础。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],

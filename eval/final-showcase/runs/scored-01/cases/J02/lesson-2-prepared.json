        "semanticRelations": [],
        "workedProcess": {
          "startingState": "△XYZ与△UVW已确立相似，约定X↔U、Y↔V、Z↔W。已知XY=4厘米，YZ=5厘米，ZX=8厘米；UV=10厘米，VW=12.5厘米，WU=20厘米。△XYZ面积为20平方厘米。",
          "inputs": [
            "XY=4厘米",
            "UV=10厘米",
            "△XYZ面积=20平方厘米"
          ],
          "ruleOrProcedure": "从XYZ到UVW的相似比k=UV÷XY（正数）；面积比=k²；新面积=原面积×k²。",
          "steps": [
            {
              "action": "列出顶点对应并算方向相似比：k = UV / XY = 10 / 4",
              "reason": "根据对应顶点U对X、V对Y，边UV对XY，用新图形UVW相对原图形XYZ的方向",
              "resultingState": "k = 2.5，且VW/YZ=12.5/5=2.5、WU/ZX=20/8=2.5，三边比一致"

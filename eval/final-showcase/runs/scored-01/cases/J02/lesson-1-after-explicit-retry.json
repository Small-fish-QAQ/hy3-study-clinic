  "lesson": {
    "objective": {
      "title": "相似图形顶点对应规则与长度面积缩放规律",
      "whyNow": "已知两三角形相似且顶点对应已给，但在面积或周长干预后常搞反放大缩小方向，需先建立对应与方向模型并练习预测。",
      "outcomes": [
        {
          "title": "确定相似比方向并避免对应边混淆",
          "description": "给定相似图形中明确的顶点对应关系，确定相似比的方向（新图形边长除以原图形边长，为正数；反向为倒数），并通过写清“新图形相对原图形”避免放大缩小算反，且不混淆不对应边或仅按位置猜测对应边。"
        },
        {
          "title": "解释长度周长按k缩放而面积按k²缩放并区分比例",
          "description": "解释相似图形中对应长度和周长按相似比k缩放，面积按k²缩放；区分面积比与长度比不同（单位分别为面积与长度，比例本身无量纲）。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "若三角形PQR与STU相似且P↔S、Q↔T、R↔U，则PQ对应ST、QR对应TU、PR对应SU。相似比k定义为新图形对应边长除以原图形对应边长，例如从PQR到STU，k=ST÷PQ，为正数；反向则为1/k。长度与周长都乘k，面积乘k²。绝不能只按图形中边的位置猜测对应，必须依据题目写明的顶点配对。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "worked_example",
        "explanation": "接下来用一个新案例展示如何逐步确认相似比方向并预测缩放结果。案例使用不同的字母与数值，以隔离核心机制。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": {
          "startingState": "三角形GHI与JKL相似，约定G↔J、H↔K、I↔L。已知GH=4厘米，HI=6厘米，JK=12厘米，KL=18厘米。现由GHI缩放得到新三角形G'H'I'，其周长是GHI周长的9倍。",
          "inputs": [
            "GH=4, JK=12",
            "HI=6, KL=18",
            "G'H'I'周长 = 9 × GHI周长"
          ],
          "ruleOrProcedure": "相似比k=新图形对应边长÷原图形对应边长（正数）。长度、周长乘k，面积乘k²。先由已知对应边确认原相似方向，再据周长反推新缩放k'。",
          "steps": [
            {
              "action": "计算GHI到JKL的相似比：k_JKL = JK ÷ GH = 12 ÷ 4 = 3",
              "reason": "顶点对应已明确，用一对对应边求比值",
              "resultingState": "确认GHI→JKL的k=3，且KL/HI=18/6=3一致"
            }
          ],

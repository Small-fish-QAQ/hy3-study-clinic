  "lesson": {
    "objective": {
      "title": "植物水分吸收、蒸腾作用与收支平衡基础",
      "whyNow": "看到两株失水相同但一株萎蔫一株正常，如何用收支差值与运输组织功能解释？",
      "outcomes": [
        {
          "title": "应用水分收支解释植物状态并区分运输组织功能",
          "description": "使用水量收支（根吸水量减失水量）解释植物体内水量变化、膨压降低或萎蔫可能，明确净变化为输入减输出而非仅看蒸腾大小，且能区分木质部运输水与无机盐、韧皮部运输有机物，不把土壤水等同于全部有机养料。"
        },
        {
          "title": "解释气孔由保卫细胞调节及其双重角色",
          "description": "解释气孔由保卫细胞调节开闭，开放利于二氧化碳进入和蒸腾失水，关闭减失水但限碳，植物需在获取碳与避免失水间平衡，不能只视气孔为无用漏水孔。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "植物体内水量取决于根吸水量与叶等失水量的差值，不是单看蒸腾大小。根毛吸收水和无机盐，木质部向上运水和无机盐，韧皮部运叶制造的糖等有机物。土壤中的水不是植物全部有机养料。建立“土壤供水→根吸收→木质部运输→叶蒸发→气孔散失”链条后，再用收支差值判断膨压与萎蔫。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "worked_example",
        "explanation": "根据资料中的规则，一段时间水量变化=吸水−失水；若吸水持续小于失水，体内水量降、膨压低可能萎蔫。木质部运水与无机盐，韧皮部运有机物，二者功能不同。下面用一例演练。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": {
          "startingState": "两株同种植物，土壤供水充足，温度、光照、气孔开度相同。丙时段吸水9克、失水7克；丁时段吸水5克、失水9克。忽略其他水量变化。",
          "inputs": [
            "丙吸水9克失水7克",
            "丁吸水5克失水9克",
            "水量变化=吸水-失水"
          ],
          "ruleOrProcedure": "水量变化=根吸水量-失水量；净负且持续则膨压降可能萎蔫。木质部运水无机盐、韧皮部运有机物功能不同。",
          "steps": [
            {
              "action": "计算丙的净水量变化",
              "reason": "代入吸水9失水7",
              "resultingState": "丙净变化为+2克，体内水量增加"
            }
          ],
          "learnerDecision": null,
          "result": null,
          "whyResultFollows": null,
          "origin": "hy3_synthesis",
          "sources": [],

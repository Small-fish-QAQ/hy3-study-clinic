  "lesson": {
    "objective": {
      "title": "植物水分吸收、蒸腾作用与收支平衡基础",
      "whyNow": "已知植物靠根系吸水并经由木质部向上，但常忽视气孔与空气湿度如何共同决定叶片失水，导致误判蒸腾结果。",
      "outcomes": [
        {
          "title": "解释根毛吸水、木质部运输与叶片蒸腾拉力的连贯机制",
          "description": "解释根毛如何增加表面积从土壤吸水，木质部导管提供向上通路，叶片水分蒸发经气孔散失形成蒸腾，其拉力是水向上运输的重要动力而非叶片主动泵出液态水，并能沿“土壤供水、根吸收、木质部运输、叶蒸发、气孔散失”建立联系。"
        },
        {
          "title": "应用条件判断蒸腾趋势及机制",
          "description": "在给定的温度、光照、叶面积、气孔开度和供水等条件保持不变时，依据空气更干燥或适度空气流动等环境变化判断蒸腾增强趋势，并解释机制为叶内外水蒸气差异更大或移走湿润空气；排除极端大风或缺水引起的气孔关闭混入同一判断。"
        }
      ]
    },
    "prerequisites": [],

        "attempt": {
          "id": "assessment_attempt_a4b1304d-028e-4bc5-a341-470ebba86ff2",
          "assessmentVersionId": "assessment_version_cc580cfd-9c64-4c3f-a13e-3daefff5ec4e",
          "workspaceId": "ws_3ea868be-3cd1-4ed9-9eb8-85cc7750c3aa",
          "ordinal": 1,
          "status": "submitted",
          "responses": {
            "assessment_item_efcc2fb3-0800-4231-ac1e-cbcd3b25ff31": "土壤湿润为番茄苗提供可用水分。根毛完好使根与土壤接触的表面积增大，有利于从湿润土壤中吸收水分及溶于水的无机盐。吸收的水进入木质部，木质部中的导管等结构通畅，形成从根到茎叶的连续向上通道，将水向上运输。在叶片中，水分蒸发成水蒸气，由于气孔开放，水蒸气主要经气孔散失到空气中，这一过程称为蒸腾。蒸腾导致叶内水势降低，产生从叶向根的拉力，该拉力是水在木质部向上运输的重要动力之一；叶片并不是把整滴液态水主动泵到空气中，而是先蒸发再以水蒸气形式经气孔扩散丢失。"
          },
          "startedAt": "2026-09-14T11:53:37.131Z",
          "submittedAt": "2026-09-14T11:54:18.828Z",
          "cancelledAt": null
        },

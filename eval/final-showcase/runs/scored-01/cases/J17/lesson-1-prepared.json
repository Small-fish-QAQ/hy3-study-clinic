  "lesson": {
    "objective": {
      "title": "基于显式条件的连接匹配、结果推导与连接类型选择",
      "whyNow": "若需从客户与订单表生成包含无订单客户的报表，应如何预测连接结果并选定连接类型？",
      "outcomes": [
        {
          "title": "解释关系连接基于显式条件及左行多匹配",
          "description": "解释关系连接根据如customer_id相等的显式条件组合两表行，并说明一个左表行可以匹配多个右表行。"
        },
        {
          "title": "推导INNER JOIN与LEFT JOIN结果并处理多匹配与未匹配",
          "description": "通过取每个左表行、在连接键上查找每个匹配右表行并发射每个对子来推导INNER JOIN和LEFT JOIN结果：INNER在无匹配时不发射，LEFT在无匹配时恰好发射一个带右表列NULL占位符的行；保留多个匹配为独立行，不汇总或去重。"
        }
      ]
    },

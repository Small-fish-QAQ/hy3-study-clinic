  "lesson": {
    "objective": {
      "title": "伸长量定义与胡克定律应用及弹簧软硬比较",
      "whyNow": "若把总长度当作伸长量，或忽略弹性范围边界，就会算出荒谬拉力；需要先建立原长、总长、伸长量三者关系并能在边界前止步。",
      "outcomes": [
        {
          "title": "识别原长、受拉总长度与伸长量及其区别",
          "description": "能够区分弹簧原长L0、受拉后总长度L与伸长量x=L-L0；认识到三者数值不同，总长度不是伸长量，原长段不能算作变形，且因回复方向而不能将伸长量任意写为负数（即伸长量为正）。"
        },
        {
          "title": "在弹性范围内应用胡克定律计算伸长量与总长并核验",
          "description": "在静止轴向拉伸且变形未超过题目给定弹性范围的条件下，应用胡克定律F=kx（使用伸长量x而非总长度L）并统一单位（如牛顿与米或厘米一致），由给定劲度系数k与拉力F计算伸长量x及受拉总长度L=L0+x；核对结果是否在模型范围内，若超出则视线性预测无效且不猜测断裂等未提供信息。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "设想一个未受拉时长为10厘米的轻弹簧，沿轴线施加拉力后静止，测得总长12厘米。按定义，伸长量是受拉后多出原长的那段变形，即x=12−10=2厘米，而不是12厘米本身。原长那10厘米早已存在，不能算作本次拉伸产生的新长度。若劲度系数k=100牛顿每米，由F=kx可得拉力为100×0.02=2牛顿；若误把总长0.12米代入，会得12牛顿，显然错。这显示总长、原长、伸长量是三个不同数值，且伸长量取正。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {

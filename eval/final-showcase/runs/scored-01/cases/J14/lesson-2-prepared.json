  "lesson": {
    "objective": {
      "title": "溶质质量分数定义、稀释混合计算与结果核对",
      "whyNow": "已知一份溶液的质量和分数，如何稳妥得到混合后的浓度？需要先建立质量分数与守恒的清晰模型。",
      "outcomes": [
        {
          "title": "按质量合并同种溶质溶液并计算混合质量分数",
          "description": "混合同种溶质的两份溶液时，先分别算盐量和总质量，再相加得总盐与总质量，用总盐除以总质量得混合质量分数；质量不同时不能直接平均百分数，若两份质量相等则简单平均在本模型中等于混合质量分数。"
        },
        {
          "title": "用范围与守恒核对稀释或混合结果",
          "description": "评估稀释或混合结果：只加水且没有移走盐时非零质量分数应下降；混合两份同种溶质溶液时结果应位于原来两种质量分数之间；范围检查有助于发现错误，但位于范围内不等于已经算对，还须核对盐量和总质量。认识加水不能把低浓度提高到高浓度，若目标更浓需要另一种明确的操作条件，本课的加水稀释式不会自动完成它。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "溶质质量分数定义为溶质质量除以溶液总质量，写成百分数。例如取40克盐溶于160克水，溶液总质量200克，质量分数为40/200=20%。本课假设盐完全溶解、无蒸发洒失，讨论只限质量。稀释只加水时盐质量不变，溶液总质量增加，分数下降。这些基础是后续混合计算的前提。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "worked_example",
        "explanation": "混合同种溶质的两份溶液，正确做法是先分别求每份的含盐量，再加总得总盐与总质量，最后相除。下面用一个新案例展示步骤，但先只算第一步，后续由你完成。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": {
          "startingState": "现有120克、质量分数15%的盐溶液与180克、质量分数25%的盐溶液，准备混合，混合后分数待求。",
          "inputs": [
            "120克、15%",
            "180克、25%"
          ],
          "ruleOrProcedure": "总盐=各份质量×分数之和；总质量=各份质量之和；混合分数=总盐/总质量。",
          "steps": [
            {
              "action": "计算第一份含盐量：120×0.15=18克，第二份含盐量：180×0.25=45克",
              "reason": "按质量分数定义分别恢复溶质质量",
              "resultingState": "第一份溶液含盐18克，第二份溶液含盐45克"
            }
          ],
          "learnerDecision": null,
          "result": null,
          "whyResultFollows": null,
          "origin": "hy3_synthesis",
          "sources": [],
          "interaction": {

  "lesson": {
    "objective": {
      "title": "函数参数区分、局部计算追踪与纯函数组合",
      "whyNow": "常看到函数内对参数名重新赋值，便以为调用处的变量也跟着变。需要先建立参数与实参分离、按值绑定的追踪模型。",
      "outcomes": [
        {
          "title": "区分函数参数与实参并解释按值传递绑定",
          "description": "能够区分函数定义中的参数名与调用时提供的实参值，并解释按值传递如何将实参值绑定到局部参数名，且对局部名的赋值不影响调用者变量。需结合本课示例说明参数与实参的区别及局部隔离。"
        },
        {
          "title": "追踪局部计算与返回调用者的值",
          "description": "在给定函数定义下，能够追踪调用过程中的传入实参、每次局部更新、return表达式及调用者中的显式赋值，并记录返回给调用者的值，同时保持返回结果与调用者变量及局部名的区分。需依据本课具体函数（如adjust、choose）演示追踪步骤。"
        }
      ]
    },
    "prerequisites": [],

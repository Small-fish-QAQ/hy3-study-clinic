  "lesson": {
    "objective": {
      "title": "功率与电能基础：定义、千瓦时、电能计算与方案比较",
      "whyNow": "已知某设备铭牌功率却测得电能与直觉不符，需要先建立功率与电能、额定与实际的区分模型才能解释。",
      "outcomes": [
        {
          "title": "区分功率与电能、解释千瓦时单位及额定功率含义",
          "description": "能够区分功率与累计电能，解释功率是能量转移或消耗的快慢、电能是一段时间内累计消耗的量；解释千瓦时是能量单位（1千瓦持续1小时对应1千瓦时），不是“每小时的功率”或更大功率单位，并说明其与焦耳的换算关系（1千瓦时=3600000焦耳）；解释设备铭牌额定功率只是规定条件下的标称参数，不一定等于整个使用过程的实际功率，因此确定实际耗电需要实际平均功率、各阶段运行时间或电表读数，而非额定功率本身。"
        },
        {
          "title": "计算恒定或分段电能及统一或分时电价电费",
          "description": "能够根据实际恒定功率或分段实际平均功率与时长计算电能，保持单位一致；分段时分别求每段电能再相加，不可简单平均功率后乘总时长；仅当题目明确授权实际功率（如“实际恒定功率”或“该段实际平均功率”）时直接相乘。能在给定统一或分时电价下计算电费：统一电价时电费=电能×电价；分时电价各段电能乘对应价再相加；金额与千瓦时分别保留单位；缺少价格规则时只报告电能不自行补出电费。"
        }
      ]
    },
    "prerequisites": [],
    "segments": [
      {
        "index": 0,
        "purpose": "orientation",
        "explanation": "功率描述能量消耗的快慢，例如100瓦灯泡比1000瓦加热器每秒转换能量慢。电能是一段时间内累计消耗的量。日常用千瓦时作能量单位：1千瓦功率持续1小时对应1千瓦时，等于3600000焦耳。它绝不是“每小时的功率”，也不是比千瓦更大的功率单位。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
        "semanticRelations": [],
        "workedProcess": null,
        "example": null,
        "contrast": null,
        "possibleMisconception": null,
        "informalCheck": null
      },
      {
        "index": 1,
        "purpose": "mechanism",
        "explanation": "当实际功率恒定时，电能等于功率乘时间。若取800瓦即0.8千瓦运行1.5小时，电能为0.8×1.5=1.2千瓦时。这说明千瓦时是这段累计能量的结果，而非某个瞬时的功率值。",
        "explanationOrigin": "hy3_synthesis",
        "sources": [],
